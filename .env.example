# ---- Required ----
# Public domain (Caddy gets the HTTPS certificate for it automatically)
DOMAIN=pager.example.com
PUBLIC_URL=https://pager.example.com
# Long random string; enables POST /api/admin/shops
ADMIN_TOKEN=change-me-to-a-long-random-string

# Image the server runs (set automatically by CD)
APP_IMAGE=ghcr.io/OWNER/REPO:latest

# Reverse proxy: "caddy" = bundled Caddy on 80/443 with automatic HTTPS.
# Remove this line when the host already runs Nginx (see README), and point Nginx at 127.0.0.1:$APP_PORT.
COMPOSE_PROFILES=caddy
# Host port (loopback only) the app is published on
APP_PORT=3000

# ---- Behaviour ----
TZ=Africa/Cairo
NONCE_ROTATE_SECONDS=60
CLAIM_RATE_PER_MIN=6
LOGIN_RATE_PER_MIN=5
LOG_LEVEL=info
# Max branch databases kept open at once (LRU); branches beyond it are reopened on demand
TENANT_DB_CACHE=200
# Branches handled per background job run (expiry/purge), round-robin
JOB_BATCH=100
# Free trial for new branches (days)
TRIAL_DAYS=3

# ---- Super dashboard (/super) ----
# scrypt hash from: docker compose exec app node src/cli.js hash-password '<password>'
# Keep it in SINGLE quotes (the hash contains $). Empty = /super is disabled.
SUPER_PASSWORD_HASH=

# ---- Weekly owner summary email (optional; off when SMTP_HOST is empty) ----
SMTP_HOST=
# 587 = STARTTLS, 465 = implicit TLS (SMTP_TLS=starttls|implicit overrides)
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Smart Pager <no-reply@aurexis.cc>

# ---- Off-site backups (optional; off unless all five BACKUP_S3_* are set) ----
# Nightly backups always go to /data/backups/<day>/ (kept 7 days). With these set, each day's
# folder is also PUT to any S3-compatible storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO),
# path-style: <endpoint>/<bucket>/<prefix>/<day>/... secrets.json is never uploaded.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=smart-pager

# ---- Web Push (auto-generated into /data/secrets.json when empty) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@aurexis.cc
# Cookie signing secret (auto-generated when empty)
COOKIE_SECRET=

# ---- Apple (optional; leave empty until you have an Apple Developer account) ----
APPLE_TEAM_ID=
# Numeric App Store ID of the full app (enables the App Clip smart banner)
APPLE_APP_ID=
APPLE_APP_BUNDLE_ID=cc.aurexis.pager
APPLE_CLIP_BUNDLE_ID=cc.aurexis.pager.Clip
APNS_KEY_ID=
# Put AuthKey_XXXX.p8 in ./secrets/ on the server (mounted read-only at /secrets)
APNS_KEY_PATH=/secrets/AuthKey.p8
APNS_ENV=production
